{
  "name": "slideforge-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p electron && electron dist/electron/main.js",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron",
    "build:backend": "pwsh backend/build_and_package.ps1",
    "package": "npm run build:renderer && npm run build:electron && npm run build:backend && electron-builder",
    "package:win": "npm run build:renderer && npm run build:electron && npm run build:backend && electron-builder --win",
    "package:mac": "npm run build:renderer && npm run build:electron && npm run build:backend && electron-builder --mac",
    "preview": "vite preview",
    "gen:api": "openapi-typescript http://127.0.0.1:8002/openapi.json -o services/api.generated.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "lucide-react": "^0.554.0",
    "pdfjs-dist": "4.8.69",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "get-port": "^7.1.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
